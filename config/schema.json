{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weight-space IDE user configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/settings"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/settings"
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "auto",
            "cpu",
            "metal"
          ]
        },
        "cpu_bridge": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "metal_bridge": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Validated at launch against the detected performance-core count; physical-core fallback, or one core when unknown. Default is the lower of 4 and that limit."
        },
        "model_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "new_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Default output request for Run and Chat, not a maximum. Requests are limited by remaining effective context."
        },
        "resident_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400,
          "description": "Idle timeout since the end of the last operation. Expiry unloads the model and never interrupts a running operation.",
          "default": 14400
        },
        "floor_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 1000000
        },
        "preferred_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 1000000
        },
        "budget_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 1000000
        },
        "ceiling_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 1000000
        },
        "swap_growth_mib": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1000000,
          "default": 64,
          "description": "Warning tolerance above the watchdog baseline while pressure is normal. Abnormal pressure stops operations independently."
        },
        "compression_growth_mib": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1000000,
          "default": 1024,
          "description": "Warning tolerance above the watchdog baseline while pressure is normal. Abnormal pressure stops operations independently."
        },
        "reservation_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 1000000
        }
      }
    }
  }
}
